# ===========================================
# Dominio publico da API (atras do Traefik)
# ===========================================
# Dominio que o Traefik vai expor para este servico, ex: ytdl.seudominio.com
API_DOMAIN=ytdl.exemplo.com

# URL publica completa (usada para montar os links de download retornados
# pela API). Deve bater com API_DOMAIN + https://
PUBLIC_BASE_URL=https://ytdl.exemplo.com

# ===========================================
# Seguranca
# ===========================================
# Chave de API exigida no header "X-API-Key" em toda requisicao (exceto
# /api/health e /api/file/{token}). Gere uma chave forte, por exemplo:
#   openssl rand -hex 32
API_KEY=troque-esta-chave-por-uma-aleatoria-e-forte

# Regex de origens permitidas por CORS (a extensao Chrome roda em
# chrome-extension://<id>, o id muda por instalacao/empacotamento).
CORS_ALLOW_ORIGIN_REGEX=^chrome-extension://.*$

# Mantenha sempre "true" em produção. Existe apenas para testes locais.
SSRF_PROTECTION_ENABLED=true

# ===========================================
# Armazenamento / limpeza automatica
# ===========================================
DOWNLOAD_DIR=/data/downloads
TMP_DIR=/data/tmp

# Minutos que um arquivo finalizado fica disponivel antes de ser apagado.
FILE_TTL_MINUTES=60

# Intervalo (segundos) entre execucoes da rotina de limpeza automatica.
CLEANUP_INTERVAL_SECONDS=300

# Tamanho maximo (MB) por download. 0 = sem limite.
MAX_FILESIZE_MB=2048

# ===========================================
# Fila de downloads
# ===========================================
MAX_CONCURRENT_DOWNLOADS=2

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://video-downloader-redis:6379/0

# ===========================================
# yt-dlp / ffmpeg
# ===========================================
FFMPEG_LOCATION=/usr/bin/ffmpeg

LOG_LEVEL=INFO
